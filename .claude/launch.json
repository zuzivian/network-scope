{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5179",
        "--strictPort"
      ],
      "port": 5179
    },
    {
      "name": "public",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run build:public && npx vite preview --mode public --port 5180 --strictPort"
      ],
      "port": 5180
    }
  ]
}